@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<a class="site__skip" href="#content">Skip to the content</a>
<div class="site">
    <header class="site__bar">
        <a class="site__brand" href="/" aria-label="RayCraft examples, home"><img src="brand/logo-on-dark.svg" alt="RayCraft" /></a>
        <span class="site__tag">Examples</span>
        <ThemeToggle />
    </header>
    <div class="site__body">
        <nav class="@(_navOpen ? "site__nav site__nav--open" : "site__nav")" aria-label="Controls">
            <button type="button" class="site__navtoggle" aria-expanded="@(_navOpen ? "true" : "false")" aria-controls="site-navbody" @onclick="ToggleNav">All controls</button>
            <div class="site__navbody" id="site-navbody">
                <ControlFilter Compact InputId="nav-filter" />
            </div>
        </nav>
        <main class="site__main" id="content" tabindex="-1">
            @Body
        </main>
    </div>
</div>
<DialogHost />
<SnackbarHost />

@code {
    private bool _navOpen;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void ToggleNav() => _navOpen = !_navOpen;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _navOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
