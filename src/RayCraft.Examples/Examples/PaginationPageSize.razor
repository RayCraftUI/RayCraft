<div class="doc-stack">
    <Pagination Count="PageCount" @bind-Page="_page" PageSizeOptions="@(new[] { 10, 25, 50 })" @bind-PageSize="_size" />
    <span>Page @_page of @PageCount (@_size rows per page, 230 rows)</span>
</div>

@code {
    private int _page = 1;
    private int _size = 10;

    private int PageCount => (int)Math.Ceiling(230d / _size);
}
